  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "csv-parse": "6.1.0"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucdesign/indesign-mcp-server.git"
  },
