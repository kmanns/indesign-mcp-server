  "description": "A comprehensive Model Context Protocol (MCP) server for Adobe InDesign automation with 51+ professional tools",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --inspect index.js",
    "test": "node --test test/*.test.js",
